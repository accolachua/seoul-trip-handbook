{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoul-trip-handbook",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SHARED_DATA",
      "id": "d30a095382b447699f61763ef22ca8e9"
    }
  ]
}
